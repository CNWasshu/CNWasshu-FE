EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_APP_ENV=local
# 로컬 API 연결 테스트 전용입니다. 실제 토큰은 .env.local에만 입력하세요.
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
# 카카오 로그인 (Expo web 기준 기본 포트 8081)
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:8081/auth/login
# Expo Go 등 실기기로 테스트할 때 쓰는 리다이렉트 URI.
# 카카오 콘솔이 exp:// 같은 커스텀 스킴은 안 받아줘서 http(s)로 등록해야 함.
# 이 컴퓨터의 Wi-Fi LAN IP:8081 로 설정하고, 카카오 콘솔 Redirect URI에도 동일하게 등록할 것.
EXPO_PUBLIC_KAKAO_NATIVE_REDIRECT_URI=http://<이-컴퓨터의-LAN-IP>:8081/auth/login

# 카카오 지도 JavaScript SDK. Web과 모바일 WebView에서 공통으로 사용합니다.
EXPO_PUBLIC_KAKAO_MAP_JS_KEY=
# 모바일 WebView의 기준 URL입니다. Kakao Developers의 JavaScript SDK 도메인에 등록하세요.
EXPO_PUBLIC_KAKAO_MAP_WEBVIEW_BASE_URL=https://localhost
